{
  "manifest_version": 3,
  "name": "EarMark — YouTube Listening Practice",
  "version": "1.0.1",
  "description": "Mark moments in YouTube videos with the Space key and replay them with subtitles and translations for listening practice.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open EarMark",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["declarativeNetRequestWithHostAccess", "contextMenus", "scripting", "activeTab"],
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*", "https://*.run.app/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "host_permissions": ["https://www.youtube.com/*"]
}
