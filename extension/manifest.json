{
  "manifest_version": 3,
  "name": "EarMark Transcripts",
  "version": "1.0.0",
  "description": "EarMark listening practice: mark moments in YouTube videos with SPACE and replay them with subtitles.",
  "action": { "default_title": "Open EarMark" },
  "background": { "service_worker": "background.js" },
  "permissions": ["declarativeNetRequestWithHostAccess"],
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*", "https://*.run.app/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "host_permissions": ["https://www.youtube.com/*"]
}
